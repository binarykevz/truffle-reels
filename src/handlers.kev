⚗ Bot Handlers
📦 "grammy" ⊢ (InlineKeyboard)
📦 "./api.kev" ⊢ (searchDramas, getEpisodes)
📦 "./helpers.kev" ⊢ (formatBookCaption, formatEpisodeCaption, scheduleDeletion)

setupHandlers ← ƒ(bot, config) → {
  bot.command("start", ƒ(ctx) → {
    🔬 { first_name } ← ctx.from
    kb ← 🧫 InlineKeyboard()
    kb.text("💘 Love", "sr:love").row()
    kb.text("🔥 Revenge", "sr:revenge").row()
    kb.text("👑 CEO", "sr:ceo")
    ctx.reply("🧪 Welcome to the lab, " ⊕ first_name ⊕ "!\nSend me a drama title.", 🧬 { reply_markup: kb }).then(ƒ(msg) → {
      scheduleDeletion(bot, msg.chat.id, msg.message_id, config.DELETION_TIME_MS)
    })
  })

  bot.on("message:text", ƒ(ctx) → {
    query ← ctx.message.text
    ❓ query.startsWith("/") ≡ false → {
      ctx.reply("🔍 Searching...").then(ƒ(msg) → { scheduleDeletion(bot, msg.chat.id, msg.message_id, config.DELETION_TIME_MS) })
      searchDramas(query, config.SEARCH_API).then(ƒ(books) → {
        ❓ books.length ≡ 0 → { ctx.reply("❌ No results.").then(ƒ(m) → { scheduleDeletion(bot, m.chat.id, m.message_id, config.DELETION_TIME_MS) }) }
        ⚠ → {
          ∑ book ∈ books.slice(0, config.MAX_SEARCH_RESULTS) → {
            caption ← formatBookCaption(book)
            kb ← 🧫 InlineKeyboard()
            kb.text("🎞 Get Episodes", "ep:" ⊕ book.bookId ⊕ ":0")
            ctx.replyWithPhoto(book.cover, 🧬 { caption: caption, reply_markup: kb }).then(ƒ(m) → { scheduleDeletion(bot, m.chat.id, m.message_id, config.DELETION_TIME_MS) })
          }
        }
      }).catch(ƒ(err) → { ctx.reply("⚠️ Error: " ⊕ err.message) })
    }
  })

  bot.on("callback_query:data", ƒ(ctx) → {
    data ← ctx.callbackQuery.data
    ctx.answerCallbackQuery()
    ❓ data.startsWith("sr:") ≡ true → {
      searchDramas(data.slice(3), config.SEARCH_API).then(ƒ(books) → {
        ∑ book ∈ books.slice(0, config.MAX_SEARCH_RESULTS) → {
          kb ← 🧫 InlineKeyboard()
          kb.text("🎞 Get Episodes", "ep:" ⊕ book.bookId ⊕ ":0")
          ctx.replyWithPhoto(book.cover, 🧬 { caption: formatBookCaption(book), reply_markup: kb }).then(ƒ(m) → { scheduleDeletion(bot, m.chat.id, m.message_id, config.DELETION_TIME_MS) })
        }
      })
    } ⚠ ❓ data.startsWith("ep:") ≡ true → {
      parts ← data.slice(3).split(":")
      bookId ← parts[0]
      offset ← Number(parts[1])
      ctx.reply("📡 Fetching...").then(ƒ(msg) → { scheduleDeletion(bot, msg.chat.id, msg.message_id, config.DELETION_TIME_MS) })
      getEpisodes(bookId, config.EPISODE_API).then(ƒ(episodes) → {
        batch ← episodes.slice(offset, offset ⊕ config.EPISODES_PER_BATCH)
        hasNext ← (offset ⊕ config.EPISODES_PER_BATCH) < episodes.length
        ∑ ep ∈ batch → {
          ❓ ep.videoUrl ≡ "" → { ↻ }
          ctx.replyWithVideo(ep.videoUrl, 🧬 { caption: formatEpisodeCaption(ep) }).then(ƒ(m) → { scheduleDeletion(bot, m.chat.id, m.message_id, config.DELETION_TIME_MS) })
        }
        ❓ hasNext ≡ true → {
          kb ← 🧫 InlineKeyboard()
          kb.text("➡️ Next 20 Episodes", "ep:" ⊕ bookId ⊕ ":" ⊕ (offset ⊕ config.EPISODES_PER_BATCH))
          ctx.reply("📺 More available:", 🧬 { reply_markup: kb }).then(ƒ(m) → { scheduleDeletion(bot, m.chat.id, m.message_id, config.DELETION_TIME_MS) })
        }
      }).catch(ƒ(err) → { ctx.reply("⚠️ Error: " ⊕ err.message) })
    }
  })
}
