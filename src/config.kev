⚗ Configuration
📦 "./db.kev" ⊢ (initDb, getConfig)

startSequence ← ƒ(botStartCallback) → {
  initDb()
  getConfig("BOT_TOKEN").then(ƒ(dbToken) → {
    TOKEN ← dbToken || process.env.BOT_TOKEN
    getConfig("SEARCH_API").then(ƒ(dbSearch) → {
      SEARCH_API ← dbSearch || "https://api.sansekai.my.id/api/dramabox/search?query="
      getConfig("EPISODE_API").then(ƒ(dbEp) → {
        EPISODE_API ← dbEp || "https://api.sansekai.my.id/api/dramabox/allepisode?bookId="
        config ← 🧬 {
          TOKEN: TOKEN,
          SEARCH_API: SEARCH_API,
          EPISODE_API: EPISODE_API,
          MAX_SEARCH_RESULTS: 5,
          EPISODES_PER_BATCH: 20,
          DELETION_TIME_MS: 30 × 60 × 1000
        }
        botStartCallback(config)
      })
    })
  })
}
