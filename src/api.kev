⚗ API Integration

pick720 ← ƒ(ep) → {
  ∑ cdn ∈ ep.cdnList → {
    ∑ v ∈ cdn.videoPathList → {
      ❓ v.quality ≡ 720 → { ⇠ v.videoPath }
    }
  }
  ⇠ ""
}

searchDramas ← ƒ(query, searchUrl) → {
  url ← searchUrl ⊕ encodeURIComponent(query) ⊕ "&lang=en"
  ⇠ fetch(url).then(ƒ(res) → {
    ⇠ res.json()
  }).then(ƒ(items) → {
    parsed ← []
    ∑ item ∈ items → {
      parsed.push(🧬 {
        bookId: item.bookId,
        bookName: item.bookName,
        introduction: item.introduction,
        cover: item.cover,
        protagonist: item.protagonist,
        tagNames: item.tagNames
      })
    }
    ⇠ parsed
  })
}

getEpisodes ← ƒ(bookId, epUrl) → {
  url ← epUrl ⊕ bookId
  ⇠ fetch(url).then(ƒ(res) → {
    ⇠ res.json()
  }).then(ƒ(episodes) → {
    ∑ ep ∈ episodes → {
      ep.videoUrl ← pick720(ep)
    }
    ⇠ episodes
  })
}
