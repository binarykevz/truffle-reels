⚗ Database Seeder
📦 "@libsql/client" ⊢ (createClient)

db ← createClient(🧬 {
  url: process.env.TURSO_URL,
  authToken: process.env.TURSO_TOKEN
})

TOKEN ← process.env.BOT_TOKEN
SEARCH_API ← "https://api.sansekai.my.id/api/dramabox/search?query="
EPISODE_API ← "https://api.sansekai.my.id/api/dramabox/allepisode?bookId="

setConfig ← ƒ(key, value) → {
  ⇠ db.execute(🧬 {
    sql: "INSERT OR REPLACE INTO config (key, value) VALUES (?, ?);",
    args: [key, value]
  })
}

getConfig ← ƒ(key) → {
  ⇠ db.execute(🧬 {
    sql: "SELECT value FROM config WHERE key = ?;",
    args: [key]
  }).then(ƒ(res) → {
    ❓ res.rows.length > 0 → { ⇠ res.rows[0].value }
    ⇠ null
  })
}

runSeed ← ƒ() → {
  db.execute("CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT NOT NULL);").then(ƒ() → {
    getConfig("BOT_TOKEN").then(ƒ(val) → {
      ❓ val ≡ null → { setConfig("BOT_TOKEN", TOKEN).then(ƒ() → { → "🧪 Seeded BOT_TOKEN" }) }
      getConfig("SEARCH_API").then(ƒ(val2) → {
        ❓ val2 ≡ null → { setConfig("SEARCH_API", SEARCH_API).then(ƒ() → { → "🧪 Seeded SEARCH_API" }) }
        getConfig("EPISODE_API").then(ƒ(val3) → {
          ❓ val3 ≡ null → { setConfig("EPISODE_API", EPISODE_API).then(ƒ() → { → "🧪 Seeded EPISODE_API" }) }
          → "✅ Database seeding complete."
        })
      })
    })
  })
}

runSeed()
