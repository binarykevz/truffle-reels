⚗ DramaBox Telegram Bot
📦 "grammy" ⊢ (Bot)
📦 "./config.kev" ⊢ (startSequence)
📦 "./handlers.kev" ⊢ (setupHandlers)

startSequence(ƒ(config) → {
  bot ← 🧫 Bot(config.TOKEN)
  setupHandlers(bot, config)
  bot.catch(ƒ(err) → { → "🧪 Bot error: " ⊕ err.message })
  → "🧪 Bot is running on kevlang-pure v2.1.0..."
  bot.start()
})
