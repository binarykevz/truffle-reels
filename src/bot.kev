⚗ DramaBox Telegram Bot (Consolidated)
📦 "dotenv" ⇤ dotenv
📦 "grammy" ⊢ (Bot, InlineKeyboard, InputFile)
📦 "@libsql/client" ⊢ (createClient)

dotenv.config()

env ← 🧬 {
  TURSO_URL: "libsql://truffle-reels-binarykevz.aws-ap-northeast-1.turso.io",
  TURSO_TOKEN: "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODcxMTkxOTYsImlkIjoiMDFhMDE4OWEtYjYwMS03ZjQ4LWEwYTUtY2M5OWJmZWRiYWQ3Iiwia2lkIjoieEtDYUItRmtDYXFYSFRCZGkzeHJlUVBhOEtRV3dvd1EtXy1PUWsxWWp6byIsInJpZCI6IjFhMDcxYzVlLWRhZWQtNGU1MC1hODgyLWJmYzFkOTc1OTRiMyJ9.-xww29ZVwVrVIbplmDR8NeDv7lpBXCwgbAnM5ASRwnSG1Buz8aSNQYKLsxSKA3fS7yGTpxp509q8Rpn5-Ks7DQ",
  BOT_TOKEN: "8970715595:AAHOvqlKVKbTnpxSPNlFAT1Lp35ZV8TKLDs"
}

DELETE_MS ← 30 × 60 × 1000

SEARCH_API ← "https://api.sansekai.my.id/api/dramabox/search?query="
EPISODE_API ← "https://api.sansekai.my.id/api/dramabox/allepisode?bookId="

db ← createClient(🧬 {
  url: env.TURSO_URL,
  authToken: env.TURSO_TOKEN
})

getConfig ← ƒ(key) → {
  p ← db.execute(🧬 {
    sql: "SELECT value FROM config WHERE key = ?;",
    args: [key]
  })
  ⇠ p.then(ƒ(res) → {
    rows ← res.rows
    ❓ rows.length > 0 → {
      first ← null
      ∑ r ∈ rows → {
        ❓ first == null → {
          first ↞ r
        }
      }
      ❓ first != null → {
        ⇠ first.value
      }
    }
    ⇠ null
  })
}

# 🧪 GENERIC ARRAY EXTRACTOR (works for both search and episodes)
extractArray ← ƒ(response) → {
  ❓ response == null → {
    ⇠ null
  }
  
  ❓ response.length != null → {
    ⇠ response
  }
  
  ❓ response.data != null → {
    ❓ response.data.length != null → {
      ⇠ response.data
    }
    ❓ response.data.list != null → {
      ⇠ response.data.list
    }
    ❓ response.data.result != null → {
      ⇠ response.data.result
    }
    ❓ response.data.items != null → {
      ⇠ response.data.items
    }
  }
  
  ❓ response.result != null → {
    ⇠ response.result
  }
  
  ❓ response.list != null → {
    ⇠ response.list
  }
  
  ❓ response.items != null → {
    ⇠ response.items
  }
  
  ❓ response.episodes != null → {
    ⇠ response.episodes
  }
  
  ⇠ null
}

getEpisodeData ← ƒ(ep) → {
  cName ← ep.chapterName
  video ← ""
  qStr ← ""
  
  cdnList ← ep.cdnList
  ❓ cdnList != null → {
    cdnLen ← cdnList.length
    ❓ cdnLen > 0 → {
      cdn ← null
      ∑ c ∈ cdnList → {
        ❓ cdn == null → {
          cdn ↞ c
        }
      }
      
      ❓ cdn != null → {
        vpl ← cdn.videoPathList
        ❓ vpl != null → {
          vplLen ← vpl.length
          ❓ vplLen > 0 → {
            v ← null
            ∑ vp ∈ vpl → {
              ❓ v == null → {
                v ↞ vp
              }
            }
            
            ❓ v != null → {
              video ↞ v.videoPath
              qStr ↞ v.quality
            }
          }
        }
      }
    }
  }
  
  ⇠ 🧬 {
    chapterName: cName,
    videoUrl: video,
    quality: qStr
  }
}

fetchAllEpisodes ← ƒ(bookId, page, collected) → {
  ❓ page > 20 → {
    ⇠ collected
  }
  
  pageUrl ← EPISODE_API ⊕ bookId ⊕ "&page=" ⊕ page
  fp ← fetch(pageUrl)
  p1 ← fp.then(ƒ(res) → {
    ⇠ res.json()
  })
  ⇠ p1.then(ƒ(response) → {
    epList ← extractArray(response)
    
    ❓ epList == null → {
      ⇠ collected
    }
    ❓ epList.length == 0 → {
      ⇠ collected
    }
    
    ∑ ep ∈ epList → {
      collected.push(ep)
    }
    
    ❓ epList.length < 40 → {
      ⇠ collected
    }
    
    ⇠ fetchAllEpisodes(bookId, page ⊕ 1, collected)
  })
}

decryptVideo ← ƒ(videoPath) → {
  decryptUrl ← "https://api.sansekai.my.id/api/dramabox/decrypt?url=" ⊕ encodeURIComponent(videoPath)
  fp ← fetch(decryptUrl)
  ⇠ fp.then(ƒ(res) → {
    ⇠ res.json()
  })
}

scheduleDeletion ← ƒ(botRef, chatId, messageId, delay) → {
  setTimeout(ƒ() → {
    api ← botRef.api
    dp ← api.deleteMessage(chatId, messageId)
    dp.catch(ƒ(err) → {
      → "⚠️ Failed to auto-delete: " ⊕ err.message
    })
  }, delay)
}

sendSearchResults ← ƒ(ctx, items, botRef) → {
  top ← items.slice(0, 5)
  ∑ item ∈ top → {
    bn ← item.bookName
    intro ← item.introduction
    prot ← item.protagonist
    tn ← item.tagNames
    tagStr ← tn.join(", ")
    caption ← "🎬 " ⊕ bn ⊕ "\n\n📖 " ⊕ intro ⊕ "\n\n🧑‍🤝‍🧑 " ⊕ prot ⊕ "\n🏷 " ⊕ tagStr
    kb ← 🧫 InlineKeyboard()
    bid ← item.bookId
    kb.text("🎞 Get Episodes", "ep:" ⊕ bid ⊕ ":0")
    cov ← item.cover
    pr ← ctx.replyWithPhoto(cov, 🧬 { caption: caption, reply_markup: kb })
    pr.then(ƒ(m) → {
      chat ← m.chat
      scheduleDeletion(botRef, chat.id, m.message_id, DELETE_MS)
    })
  }
}

initP ← db.execute("CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT NOT NULL);")
initP.then(ƒ() → {
  → "🗄️ Database initialized."
  t1 ← getConfig("BOT_TOKEN")
  t1.then(ƒ(dbToken) → {
    TOKEN ← dbToken
    ❓ dbToken == null → {
      TOKEN ↞ env.BOT_TOKEN
    }

    bot ← 🧫 Bot(TOKEN)

    bot.command("start", ƒ(ctx) → {
      from ← ctx.from
      🔬 { first_name } ← from
      kb ← 🧫 InlineKeyboard()
      kb.text("💘 Love", "sr:love")
      kb.row()
      kb.text("🔥 Revenge", "sr:revenge")
      kb.row()
      kb.text("👑 CEO", "sr:ceo")
      rp ← ctx.reply("🧪 Welcome to the lab, " ⊕ first_name ⊕ "!\nSend me a drama title.", 🧬 { reply_markup: kb })
      rp.then(ƒ(m) → {
        chat ← m.chat
        scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
      })
    })

    bot.on("message:text", ƒ(ctx) → {
      msg ← ctx.message
      query ← msg.text
      isCmd ← query.startsWith("/")
      ❓ isCmd == false → {
        rp ← ctx.reply("🔍 Searching...")
        rp.then(ƒ(m) → {
          chat ← m.chat
          scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
        })
        encoded ← encodeURIComponent(query)
        url ← SEARCH_API ⊕ encoded ⊕ "&lang=en"
        fp ← fetch(url)
        p1 ← fp.then(ƒ(res) → {
          ⇠ res.json()
        })
        p2 ← p1.then(ƒ(response) → {
          # 🧪 EXTRACT ARRAY FROM SEARCH RESPONSE
          items ← extractArray(response)
          
          ❓ items == null → {
            ctx.reply("❌ Could not parse search results.")
            ⇠
          }
          
          len ← items.length
          ❓ len == 0 → {
            nr ← ctx.reply("❌ No results.")
            nr.then(ƒ(m2) → {
              c2 ← m2.chat
              scheduleDeletion(bot, c2.id, m2.message_id, DELETE_MS)
            })
          } ⚠ → {
            sendSearchResults(ctx, items, bot)
          }
        })
        p2.catch(ƒ(err) → {
          → "DEBUG TEXT SEARCH ERROR: " ⊕ err.message
        })
      }
    })

    bot.on("callback_query:data", ƒ(ctx) → {
      cq ← ctx.callbackQuery
      data ← cq.data
      ctx.answerCallbackQuery()
      
      isSr ← data.startsWith("sr:")
      isEp ← data.startsWith("ep:")
      isPlay ← data.startsWith("play:")
      
      ❓ isSr == true → {
        sliced ← data.slice(3)
        encoded ← encodeURIComponent(sliced)
        url ← SEARCH_API ⊕ encoded ⊕ "&lang=en"
        fp ← fetch(url)
        p1 ← fp.then(ƒ(res) → {
          ⇠ res.json()
        })
        p2 ← p1.then(ƒ(response) → {
          # 🧪 EXTRACT ARRAY FROM SEARCH RESPONSE
          items ← extractArray(response)
          
          ❓ items == null → {
            ctx.reply("❌ Could not parse search results.")
            ⇠
          }
          
          len ← items.length
          ❓ len == 0 → {
            ctx.reply("❌ No results.")
          } ⚠ → {
            sendSearchResults(ctx, items, bot)
          }
        })
        p2.catch(ƒ(err) → {
          → "DEBUG SEARCH CB ERROR: " ⊕ err.message
        })
      } 
      
      ⚠ ❓ isEp == true → {
        sliced ← data.slice(3)
        colonPos ← sliced.indexOf(":")
        bookId ← ""
        offset ← 0
        
        ❓ colonPos == -1 → {
          bookId ↞ sliced
        } ⚠ → {
          bookId ↞ sliced.substring(0, colonPos)
          offsetStr ← sliced.substring(colonPos ⊕ 1)
          offset ↞ Number(offsetStr)
        }
        
        rp ← ctx.reply("📡 Fetching all episodes...")
        rp.then(ƒ(m) → {
          chat ← m.chat
          scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
        })
        
        allEps ← []
        fetchPromise ← fetchAllEpisodes(bookId, 1, allEps)
        fetchPromise.then(ƒ(epList) → {
          ❓ epList == null → {
            ctx.reply("❌ Could not fetch episodes.")
            ⇠
          }
          
          len ← epList.length
          ❓ len == 0 → {
            ctx.reply("❌ No episodes found for this book.")
            ⇠
          }
          
          → "DEBUG TOTAL EPISODES FETCHED: " ⊕ len
          
          end ← offset ⊕ 10
          ❓ end > len → {
            end ↞ len
          }
          
          batch ← epList.slice(offset, end)
          kb ← 🧫 InlineKeyboard()
          counter ← offset
          
          ∑ ep ∈ batch → {
            kb.text(ep.chapterName, "play:" ⊕ bookId ⊕ ":" ⊕ counter)
            kb.row()
            counter ↞ counter ⊕ 1
          }
          
          nextOff ← offset ⊕ 10
          hasNext ← nextOff < len
          ❓ hasNext == true → {
            kb.text("➡️ Next 10 Episodes", "ep:" ⊕ bookId ⊕ ":" ⊕ nextOff)
          }
          
          ❓ offset > 0 → {
            prevOff ← offset − 10
            ❓ prevOff < 0 → {
              prevOff ↞ 0
            }
            kb.text("⬅️ Previous 10", "ep:" ⊕ bookId ⊕ ":" ⊕ prevOff)
          }
          
          mr ← ctx.reply("🎬 Select an episode (" ⊕ len ⊕ " total):", 🧬 { reply_markup: kb })
          mr.then(ƒ(m5) → {
            chat ← m5.chat
            scheduleDeletion(bot, chat.id, m5.message_id, DELETE_MS)
          })
        })
        fetchPromise.catch(ƒ(err) → {
          → "DEBUG FETCH ALL ERROR: " ⊕ err.message
          ctx.reply("⚠️ Error fetching episodes: " ⊕ err.message)
        })
      }
      
      ⚠ ❓ isPlay == true → {
        sliced ← data.slice(5)
        colonPos ← sliced.indexOf(":")
        bookId ← ""
        epIndex ← 0
        
        ❓ colonPos == -1 → {
          bookId ↞ sliced
        } ⚠ → {
          bookId ↞ sliced.substring(0, colonPos)
          indexStr ← sliced.substring(colonPos ⊕ 1)
          epIndex ↞ Number(indexStr)
        }
        
        rp ← ctx.reply("🔐 Fetching and decrypting video...")
        rp.then(ƒ(m) → {
          chat ← m.chat
          scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
        })
        
        allEps ← []
        fetchPromise ← fetchAllEpisodes(bookId, 1, allEps)
        fetchPromise.then(ƒ(epList) → {
          ❓ epList == null → {
            ctx.reply("❌ Could not fetch episodes.")
            ⇠
          }
          
          len ← epList.length
          ❓ epIndex >= len → {
            ctx.reply("❌ Episode not found.")
            ⇠
          }
          
          targetEp ← null
          currentIndex ← 0
          ∑ e ∈ epList → {
            ❓ currentIndex == epIndex → {
              targetEp ↞ e
            }
            currentIndex ↞ currentIndex ⊕ 1
          }
          
          ❓ targetEp == null → {
            ctx.reply("❌ Could not locate episode.")
            ⇠
          }
          
          parsedEp ← getEpisodeData(targetEp)
          encryptedVideo ← parsedEp.videoUrl
          cName ← parsedEp.chapterName
          qStr ← parsedEp.quality
          
          ❓ encryptedVideo == "" → {
            ctx.reply("⚠️ No video URL found for " ⊕ cName)
            ⇠
          }
          
          dp ← decryptVideo(encryptedVideo)
          dp.then(ƒ(decryptResult) → {
            streamUrl ← decryptResult.streamUrl
            
            ❓ streamUrl == null → {
              ctx.reply("⚠️ Failed to decrypt " ⊕ cName)
              ⇠
            }
            
            cap ← "🎬 " ⊕ cName ⊕ " (" ⊕ qStr ⊕ "p) ⏳ Auto-deletes in 30m"
            
            vfp ← fetch(streamUrl)
            vfp.then(ƒ(vres) → {
              videoStream ← vres.body
              videoFile ← 🧫 InputFile(videoStream, cName ⊕ ".mp4")
              
              vr ← ctx.replyWithVideo(videoFile, 🧬 { caption: cap })
              
              vr.then(ƒ(m4) → {
                chat ← m4.chat
                scheduleDeletion(bot, chat.id, m4.message_id, DELETE_MS)
              })
              
              vr.catch(ƒ(err) → {
                → "⚠️ Video send failed for " ⊕ cName ⊕ ": " ⊕ err.message
                fallbackMsg ← "⚠️ Video upload failed. Link:\n🔗 " ⊕ streamUrl
                fr ← ctx.reply(fallbackMsg)
                fr.then(ƒ(fm) → {
                  chat ← fm.chat
                  scheduleDeletion(bot, chat.id, fm.message_id, DELETE_MS)
                })
              })
            })
            
            vfp.catch(ƒ(err) → {
              → "⚠️ Video download failed for " ⊕ cName ⊕ ": " ⊕ err.message
              ctx.reply("⚠️ Failed to download video for " ⊕ cName)
            })
          })
          
          dp.catch(ƒ(err) → {
            → "⚠️ Decrypt error for " ⊕ cName ⊕ ": " ⊕ err.message
            ctx.reply("⚠️ Decrypt failed for " ⊕ cName)
          })
        })
        fetchPromise.catch(ƒ(err) → {
          → "DEBUG PLAY FETCH ERROR: " ⊕ err.message
          ctx.reply("⚠️ Error fetching episode: " ⊕ err.message)
        })
      }
    })

    bot.catch(ƒ(err) → {
      → "🧪 Bot error: " ⊕ err.message
    })

    → "🧪 Bot is running on kevlang-pure v2.1.0..."
    bot.start()
  })
})
