⚗ DramaBox Telegram Bot (Consolidated)
📦 "dotenv" ⇤ dotenv
📦 "grammy" ⊢ (Bot, InlineKeyboard, InputFile)
📦 "@libsql/client" ⊢ (createClient)

dotenv.config()

env ← 🧬 {
  TURSO_URL: "libsql://truffle-reels-binarykevz.aws-ap-northeast-1.turso.io",
  TURSO_TOKEN: "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODcxMTkxOTYsImlkIjoiMDFhMDE4OWEtYjYwMS03ZjQ4LWEwYTUtY2M5OWJmZWRiYWQ3Iiwia2lkIjoieEtDYUItRmtDYXFYSFRCZGkzeHJlUVBhOEtRV3dvd1EtXy1PUWsxWWp6byIsInJpZCI6IjFhMDcxYzVlLWRhZWQtNGU1MC1hODgyLWJmYzFkOTc1OTRiMyJ9.-xww29ZVwVrVIbplmDR8NeDv7lpBXCwgbAnM5ASRwnSG1Buz8aSNQYKLsxSKA3fS7yGTpxp509q8Rpn5-Ks7DQ",
  BOT_TOKEN: "8970715595:AAHOvqlKVKbTnpxSPNlFAT1Lp35ZV8TKLDs"
}

DELETE_MS ← 30 × 60 × 1000
COLS ← 5

db ← createClient(🧬 {
  url: env.TURSO_URL,
  authToken: env.TURSO_TOKEN
})

getConfig ← ƒ(key) → {
  p ← db.execute(🧬 {
    sql: "SELECT value FROM config WHERE key = ?;",
    args: [key]
  })
  ⇠ p.then(ƒ(res) → {
    rows ← res.rows
    ❓ rows.length > 0 → {
      first ← null
      ∑ r ∈ rows → {
        ❓ first == null → {
          first ↞ r
        }
      }
      ❓ first != null → {
        ⇠ first.value
      }
    }
    ⇠ null
  })
}

extractArray ← ƒ(response) → {
  ❓ response == null → {
    ⇠ null
  }
  
  ❓ response.length != null → {
    ⇠ response
  }
  
  ❓ response.data != null → {
    ❓ response.data.length != null → {
      ⇠ response.data
    }
    ❓ response.data.list != null → {
      ⇠ response.data.list
    }
    ❓ response.data.result != null → {
      ⇠ response.data.result
    }
    ❓ response.data.items != null → {
      ⇠ response.data.items
    }
    ❓ response.data.episodes != null → {
      ⇠ response.data.episodes
    }
  }
  
  ❓ response.result != null → {
    ⇠ response.result
  }
  
  ❓ response.list != null → {
    ⇠ response.list
  }
  
  ❓ response.items != null → {
    ⇠ response.items
  }
  
  ❓ response.episodes != null → {
    ⇠ response.episodes
  }
  
  ⇠ null
}

getEpisodeData ← ƒ(ep) → {
  cName ← ep.chapterName
  video ← ""
  qStr ← ""
  
  cdnList ← ep.cdnList
  ❓ cdnList != null → {
    cdnLen ← cdnList.length
    ❓ cdnLen > 0 → {
      cdn ← null
      ∑ c ∈ cdnList → {
        ❓ cdn == null → {
          cdn ↞ c
        }
      }
      
      ❓ cdn != null → {
        vpl ← cdn.videoPathList
        ❓ vpl != null → {
          vplLen ← vpl.length
          ❓ vplLen > 0 → {
            v ← null
            ∑ vp ∈ vpl → {
              ❓ v == null → {
                v ↞ vp
              }
            }
            
            ❓ v != null → {
              video ↞ v.videoPath
              qStr ↞ v.quality
            }
          }
        }
      }
    }
  }
  
  ⇠ 🧬 {
    chapterName: cName,
    videoUrl: video,
    quality: qStr
  }
}

fetchEpisodesForBook ← ƒ(bookId, apiUrl) → {
  epUrl ← apiUrl ⊕ bookId
  fp ← fetch(epUrl)
  p1 ← fp.then(ƒ(res) → {
    ⇠ res.json()
  })
  ⇠ p1.then(ƒ(response) → {
    epList ← extractArray(response)
    ❓ epList == null → {
      ⇠ []
    }
    ⇠ epList
  })
}

decryptVideo ← ƒ(videoPath) → {
  decryptUrl ← "https://api.sansekai.my.id/api/dramabox/decrypt?url=" ⊕ encodeURIComponent(videoPath)
  fp ← fetch(decryptUrl)
  ⇠ fp.then(ƒ(res) → {
    ⇠ res.json()
  })
}

scheduleDeletion ← ƒ(botRef, chatId, messageId, delay) → {
  setTimeout(ƒ() → {
    api ← botRef.api
    dp ← api.deleteMessage(chatId, messageId)
    dp.catch(ƒ(err) → {
      → "⚠️ Failed to auto-delete: " ⊕ err.message
    })
  }, delay)
}

sendSearchResults ← ƒ(ctx, items, botRef) → {
  top ← items.slice(0, 5)
  ∑ item ∈ top → {
    bn ← item.bookName
    intro ← item.introduction
    prot ← item.protagonist
    tn ← item.tagNames
    tagStr ← tn.join(", ")
    caption ← "🎬 " ⊕ bn ⊕ "\n\n📖 " ⊕ intro ⊕ "\n\n🧑‍🤝‍🧑 " ⊕ prot ⊕ "\n🏷 " ⊕ tagStr
    kb ← 🧫 InlineKeyboard()
    bid ← item.bookId
    kb.text("🎞 Episodes", "ep:" ⊕ bid)
    cov ← item.cover
    pr ← ctx.replyWithPhoto(cov, 🧬 { caption: caption, reply_markup: kb })
    pr.then(ƒ(m) → {
      chat ← m.chat
      scheduleDeletion(botRef, chat.id, m.message_id, DELETE_MS)
    })
  }
}

initP ← db.execute("CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT NOT NULL);")
initP.then(ƒ() → {
  → "🗄️ Database ready."
  
  t1 ← getConfig("BOT_TOKEN")
  t1.then(ƒ(dbToken) → {
    TOKEN ← dbToken
    ❓ dbToken == null → {
      TOKEN ↞ env.BOT_TOKEN
    }
    
    # 🧪 LOAD APIs EXCLUSIVELY FROM TURSO
    t2 ← getConfig("SEARCH_API")
    t2.then(ƒ(dbSearch) → {
      SEARCH_API ← dbSearch
      ❓ dbSearch == null → {
        SEARCH_API ↞ ""
        → "⚠️ SEARCH_API not found in Turso!"
        → "💡 Add it via: INSERT INTO config (key, value) VALUES ('SEARCH_API', 'your_url')"
      } ⚠ → {
        → "✅ SEARCH_API loaded from Turso"
      }
      
      t3 ← getConfig("EPISODE_API")
      t3.then(ƒ(dbEpisode) → {
        EPISODE_API ← dbEpisode
        ❓ dbEpisode == null → {
          EPISODE_API ↞ ""
          → "⚠️ EPISODE_API not found in Turso!"
          → "💡 Add it via: INSERT INTO config (key, value) VALUES ('EPISODE_API', 'your_url')"
        } ⚠ → {
          → "✅ EPISODE_API loaded from Turso"
        }

        bot ← 🧫 Bot(TOKEN)

        bot.command("start", ƒ(ctx) → {
          from ← ctx.from
          🔬 { first_name } ← from
          kb ← 🧫 InlineKeyboard()
          kb.text("💘 Romance", "sr:love")
          kb.text("⚔️ Action", "sr:action")
          kb.text("👔 CEO", "sr:ceo")
          kb.text("🔮 Fantasy", "sr:fantasy")
          rp ← ctx.reply("✨ Welcome, " ⊕ first_name ⊕ "!\n\n🎭 Send me a drama title to search.", 🧬 { reply_markup: kb })
          rp.then(ƒ(m) → {
            chat ← m.chat
            scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
          })
        })

        bot.on("message:text", ƒ(ctx) → {
          msg ← ctx.message
          query ← msg.text
          isCmd ← query.startsWith("/")
          ❓ isCmd == false → {
            ❓ SEARCH_API == "" → {
              ctx.reply("⚠️ Search API not configured in database.")
              ⇠
            }
            rp ← ctx.reply("🔍 Searching...")
            rp.then(ƒ(m) → {
              chat ← m.chat
              scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
            })
            encoded ← encodeURIComponent(query)
            url ← SEARCH_API ⊕ encoded ⊕ "&lang=en"
            fp ← fetch(url)
            p1 ← fp.then(ƒ(res) → {
              ⇠ res.json()
            })
            p2 ← p1.then(ƒ(response) → {
              items ← extractArray(response)
              
              ❓ items == null → {
                ctx.reply("❌ Could not parse results.")
                ⇠
              }
              
              len ← items.length
              ❓ len == 0 → {
                nr ← ctx.reply("❌ No results found.")
                nr.then(ƒ(m2) → {
                  c2 ← m2.chat
                  scheduleDeletion(bot, c2.id, m2.message_id, DELETE_MS)
                })
              } ⚠ → {
                sendSearchResults(ctx, items, bot)
              }
            })
            p2.catch(ƒ(err) → {
              → "SEARCH ERROR: " ⊕ err.message
            })
          }
        })

        bot.on("callback_query:data", ƒ(ctx) → {
          cq ← ctx.callbackQuery
          data ← cq.data
          ctx.answerCallbackQuery()
          
          isSr ← data.startsWith("sr:")
          isEp ← data.startsWith("ep:")
          isPlay ← data.startsWith("play:")
          
          ❓ isSr == true → {
            ❓ SEARCH_API == "" → {
              ctx.reply("⚠️ Search API not configured.")
              ⇠
            }
            sliced ← data.slice(3)
            encoded ← encodeURIComponent(sliced)
            url ← SEARCH_API ⊕ encoded ⊕ "&lang=en"
            fp ← fetch(url)
            p1 ← fp.then(ƒ(res) → {
              ⇠ res.json()
            })
            p2 ← p1.then(ƒ(response) → {
              items ← extractArray(response)
              
              ❓ items == null → {
                ctx.reply("❌ Could not parse results.")
                ⇠
              }
              
              len ← items.length
              ❓ len == 0 → {
                ctx.reply("❌ No results.")
              } ⚠ → {
                sendSearchResults(ctx, items, bot)
              }
            })
            p2.catch(ƒ(err) → {
              → "SEARCH CB ERROR: " ⊕ err.message
            })
          } 
          
          ⚠ ❓ isEp == true → {
            ❓ EPISODE_API == "" → {
              ctx.reply("⚠️ Episode API not configured.")
              ⇠
            }
            bookId ← data.slice(3)
            
            rp ← ctx.reply("⏳ Loading episodes...")
            rp.then(ƒ(m) → {
              chat ← m.chat
              scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
            })
            
            fetchPromise ← fetchEpisodesForBook(bookId, EPISODE_API)
            fetchPromise.then(ƒ(epList) → {
              len ← epList.length
              ❓ len == 0 → {
                ctx.reply("❌ No episodes found.")
                ⇠
              }
              
              kb ← 🧫 InlineKeyboard()
              counter ← 0
              
              ∑ ep ∈ epList → {
                epNum ← counter ⊕ 1
                kb.text("▶" ⊕ epNum, "play:" ⊕ bookId ⊕ ":" ⊕ counter)
                colCheck ← (counter ⊕ 1) ÷ COLS
                ❓ (counter ⊕ 1) == (colCheck × COLS) → {
                  kb.row()
                }
                counter ↞ counter ⊕ 1
              }
              
              ❓ (counter ÷ COLS) × COLS < counter → {
                kb.row()
              }
              
              header ← "🎬 𝗘𝗽𝗶𝘀𝗼𝗱𝗲𝘀\n━━━━━━━━━━━\n📺 Total: " ⊕ len ⊕ " episodes\n👇 Tap to watch:"
              mr ← ctx.reply(header, 🧬 { reply_markup: kb })
              mr.then(ƒ(m5) → {
                chat ← m5.chat
                scheduleDeletion(bot, chat.id, m5.message_id, DELETE_MS)
              })
            })
            fetchPromise.catch(ƒ(err) → {
              ctx.reply("⚠️ Error: " ⊕ err.message)
            })
          }
          
          ⚠ ❓ isPlay == true → {
            ❓ EPISODE_API == "" → {
              ctx.reply("⚠️ Episode API not configured.")
              ⇠
            }
            sliced ← data.slice(5)
            colonPos ← sliced.indexOf(":")
            bookId ← ""
            epIndex ← 0
            
            ❓ colonPos == -1 → {
              bookId ↞ sliced
            } ⚠ → {
              bookId ↞ sliced.substring(0, colonPos)
              indexStr ← sliced.substring(colonPos ⊕ 1)
              epIndex ↞ Number(indexStr)
            }
            
            rp ← ctx.reply("🔓 Decrypting...")
            rp.then(ƒ(m) → {
              chat ← m.chat
              scheduleDeletion(bot, chat.id, m.message_id, DELETE_MS)
            })
            
            fetchPromise ← fetchEpisodesForBook(bookId, EPISODE_API)
            fetchPromise.then(ƒ(epList) → {
              len ← epList.length
              ❓ epIndex >= len → {
                ctx.reply("❌ Episode not found.")
                ⇠
              }
              
              targetEp ← null
              currentIndex ← 0
              ∑ e ∈ epList → {
                ❓ currentIndex == epIndex → {
                  targetEp ↞ e
                }
                currentIndex ↞ currentIndex ⊕ 1
              }
              
              ❓ targetEp == null → {
                ctx.reply("❌ Could not locate episode.")
                ⇠
              }
              
              parsedEp ← getEpisodeData(targetEp)
              encryptedVideo ← parsedEp.videoUrl
              cName ← parsedEp.chapterName
              qStr ← parsedEp.quality
              
              ❓ encryptedVideo == "" → {
                ctx.reply("⚠️ No video found for " ⊕ cName)
                ⇠
              }
              
              dp ← decryptVideo(encryptedVideo)
              dp.then(ƒ(decryptResult) → {
                streamUrl ← decryptResult.streamUrl
                
                ❓ streamUrl == null → {
                  ctx.reply("⚠️ Decrypt failed for " ⊕ cName)
                  ⇠
                }
                
                cap ← "🎬 " ⊕ cName ⊕ " • " ⊕ qStr ⊕ "p\n⏳ Auto-deletes in 30m"
                
                vfp ← fetch(streamUrl)
                vfp.then(ƒ(vres) → {
                  videoStream ← vres.body
                  videoFile ← 🧫 InputFile(videoStream, cName ⊕ ".mp4")
                  
                  vr ← ctx.replyWithVideo(videoFile, 🧬 { caption: cap })
                  
                  vr.then(ƒ(m4) → {
                    chat ← m4.chat
                    scheduleDeletion(bot, chat.id, m4.message_id, DELETE_MS)
                  })
                  
                  vr.catch(ƒ(err) → {
                    → "VIDEO SEND FAILED: " ⊕ err.message
                    fallbackMsg ← "⚠️ Upload failed.\n🔗 " ⊕ streamUrl
                    fr ← ctx.reply(fallbackMsg)
                    fr.then(ƒ(fm) → {
                      chat ← fm.chat
                      scheduleDeletion(bot, chat.id, fm.message_id, DELETE_MS)
                    })
                  })
                })
                
                vfp.catch(ƒ(err) → {
                  ctx.reply("⚠️ Download failed")
                })
              })
              
              dp.catch(ƒ(err) → {
                ctx.reply("⚠️ Decrypt error")
              })
            })
            fetchPromise.catch(ƒ(err) → {
              ctx.reply("⚠️ Error: " ⊕ err.message)
            })
          }
        })

        bot.catch(ƒ(err) → {
          → "🧪 Bot error: " ⊕ err.message
        })

        → "🧪 Bot running • APIs loaded from Turso"
        bot.start()
      })
    })
  })
})
