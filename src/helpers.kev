⚗ Utility Helpers

formatBookCaption ← ƒ(book) → {
  tags ← book.tagNames.join(", ")
  caption ← "🎬 " ⊕ book.bookName
  caption ↞ caption ⊕ "\n\n📖 " ⊕ book.introduction
  caption ↞ caption ⊕ "\n\n🧑‍🤝‍🧑 " ⊕ book.protagonist
  caption ↞ caption ⊕ "\n🏷 " ⊕ tags
  ⇠ caption
}

formatEpisodeCaption ← ƒ(ep) → {
  ⇠ "🎬 " ⊕ ep.chapterName ⊕ " (720p) ⏳ Auto-deletes in 30m"
}

scheduleDeletion ← ƒ(bot, chatId, messageId, delay) → {
  setTimeout(ƒ() → {
    bot.api.deleteMessage(chatId, messageId).catch(ƒ(err) → {
      → "⚠️ Failed to auto-delete: " ⊕ err.message
    })
  }, delay)
}
